# Common Aliases, Functions, and Exports for Bash and Zsh

# --- Auto-Refresh (Once per session) ---
case "$-" in
	*i*)
		if [ ! -f "$HOME/.dotfiles_initialized_$(id -u)" ]
		then
			if ! command -v zoxide >/dev/null 2>&1
			then
				echo "[Auto-Setup] Essential tools missing. Running setup..."
				local repo_path="$HOME/.dotfiles"
				[ -f "$HOME/.dotfiles-path" ] && repo_path=$(cat "$HOME/.dotfiles-path")
				SETUP_SCRIPT="$repo_path/.setup.sh"
				if [ -f "$SETUP_SCRIPT" ]
				then
					bash "$SETUP_SCRIPT"
				else
					echo "[Auto-Setup] Error: Could not find .setup.sh"
				fi
			fi
			touch "$HOME/.dotfiles_initialized_$(id -u)"
		fi
		;;
esac

# --- Command Color Settings ---
alias ls='ls --color=auto'

if command -v rg >/dev/null 2>&1
then
	alias grep='rg'
else
	alias grep='grep --color=auto'
fi

if command -v ip >/dev/null 2>&1
then
	alias ip='ip -color=auto'
fi
alias rm='rm -I'

# --- Disk Usage ---
alias df='df -h'
alias free='free -m'

# --- Processes ---
alias psa="ps auxf"
alias psgrep="ps aux | grep -v grep | grep -i -e VSZ -e"
alias psmem='ps auxf | sort -nr -k 4'
alias pscpu='ps auxf | sort -nr -k 3'

# --- Modern Tool Aliases ---
if command -v batcat > /dev/null 2>&1
then
	alias cat='batcat --paging=never'
elif command -v bat > /dev/null 2>&1
then
	alias cat='bat --paging=never'
fi

if command -v fdfind > /dev/null 2>&1
then
	alias find='fdfind'
elif command -v fd > /dev/null 2>&1
then
	alias find='fd'
fi

# Fallback alias for neovim (uses Flatpak if nvim is not in PATH)
if ! command -v nvim >/dev/null 2>&1 && command -v flatpak >/dev/null 2>&1
then
	# Zero-cost check: verify the app directory exists system-wide or user-wide
	if [ -d "/var/lib/flatpak/app/io.neovim.nvim" ] || [ -d "$HOME/.local/share/flatpak/app/io.neovim.nvim" ]
	then
		alias nvim='flatpak run io.neovim.nvim'
	fi
fi

# Fallback alias for VS Code (uses Flatpak)
if command -v flatpak >/dev/null 2>&1
then
	if [ -d "/var/lib/flatpak/app/com.visualstudio.code" ] || [ -d "$HOME/.local/share/flatpak/app/com.visualstudio.code" ]
	then
		alias code='flatpak run com.visualstudio.code'
	fi
fi

# --- Utility Functions ---

mkcd()
{
	mkdir -p "$1" && cd "$1"
}

alias compile='compiler'
compiler()
{
	if [ -z "$1" ]
	then
		echo "Missing operand" >&2
		return 1
	fi
	
	if [ ! -r "$1" ]
	then
		printf "File %s does not exist or is not readable\n" "$1" >&2
		return 1
	fi
	
	local output_path
	output_path=$(mktemp "${TMPDIR:-/tmp}/${1##*/}.XXXXXX") || { echo "Failed to create temp file" >&2; return 1; }
	
	gcc "$1" -Wall -Wextra -Werror -o "$output_path" && "$output_path"
	local ret_code=$? # Capture exit code
	
	rm "$output_path"
	return $ret_code
}

alias extract='extractor'
extractor()
{
	local c e i
	
	for i in "$@"
	do
		if [ ! -f "$i" ]
		then
			echo "extractor: File '$i' does not exist." >&2
			continue
		fi
		
		c=0
		e=0
		
		if command -v bsdtar >/dev/null 2>&1
		then
			case "$i" in
				*.tar.bz2|*.tar.gz|*.tar.xz|*.tbz2|*.tgz|*.txz|*.tar) bsdtar xvf "$i" || e=1 ;;
				*.zip) unzip "$i" || e=1 ;;
				*.rar) unrar x "$i" || e=1 ;;
				*.7z) 7z x "$i" || e=1 ;;
				*.gz) gunzip "$i" || e=1 ;;
				*.xz) unxz "$i" || e=1 ;;
				*.zst) unzstd "$i" || e=1 ;;
				*) echo "extractor: Skipped '$i' (unknown extension)." >&2; c=1 ;;
			esac
		else
			# Fallback to standard native tools if bsdtar is missing
			case "$i" in
				*.tar.bz2|*.tbz2) tar xvjf "$i" || e=1 ;;
				*.tar.gz|*.tgz) tar xvzf "$i" || e=1 ;;
				*.tar.xz|*.txz) tar xvJf "$i" || e=1 ;;
				*.tar) tar xvf "$i" || e=1 ;;
				*.zip) unzip "$i" || e=1 ;;
				*.rar) unrar x "$i" || e=1 ;;
				*.7z) 7z x "$i" || e=1 ;;
				*.gz) gunzip "$i" || e=1 ;;
				*.xz) unxz "$i" || e=1 ;;
				*.zst) unzstd "$i" || e=1 ;;
				*) echo "extractor: Skipped '$i' (unknown extension or missing tool)." >&2; c=1 ;;
			esac
		fi
		
		if [ $e -eq 0 ] && [ $c -eq 0 ]
		then
			echo "extractor: Successfully extracted '$i'"
		elif [ $e -eq 1 ]
		then
			echo "extractor: Encountered an error extracting '$i'" >&2
		fi
	done
}

# --- Service User (for Prompt) ---
service_user()
{
	echo "ervice"
}

# --- Dotfiles Management Wrappers ---
__get_dotfiles_repo_root()
{
	if [ -f "$HOME/.dotfiles-path" ]
	then
		cat "$HOME/.dotfiles-path"
	else
		echo "$HOME/.dotfiles" # Fallback
	fi
}

refresh()
{
	local REPO_ROOT
	REPO_ROOT=$(__get_dotfiles_repo_root)
	bash "$REPO_ROOT/.scripts/refresh.sh" "$@"
	# Re-source the definitions after refresh
	if [ -f "$HOME/.sh_common" ]
	then
		. "$HOME/.sh_common"
	fi
}

cleanup()
{
	local REPO_ROOT
	REPO_ROOT=$(__get_dotfiles_repo_root)
	bash "$REPO_ROOT/.scripts/cleanup.sh" "$@"
}

startfresh()
{
	local REPO_ROOT
	REPO_ROOT=$(__get_dotfiles_repo_root)
	bash "$REPO_ROOT/.scripts/startfresh.sh" "$@"
}

# --- Network ---
alias ipinfo='ipinformation'
ipinformation()
{
	if [ -z "$1" ]
	then
		curl https://ipinfo.io | grep -v '"readme":'
	else
		curl "https://ipinfo.io/$1" | grep -v '"readme":'
	fi
	echo
}
alias networkscan='nmap -T4 -F'

# --- System & Security ---
if sudo -n true 2>/dev/null
then
	alias audit='sudo lynis audit system'
else
	alias audit='lynis audit system'
fi

# --- Load Local Secrets (Ignored by Git) ---
if [ -f "$HOME/.config/shell_secrets" ]
then
	. "$HOME/.config/shell_secrets"
fi

# --- PATH Modifications (Secure Append) ---
case ":$PATH:" in
	*":$HOME/.local/bin:"*) ;;
	*) [ -d "$HOME/.local/bin" ] && export PATH="$PATH:$HOME/.local/bin" ;;
esac

# --- Auto-configure Git GPG Signing ---
if command -v git >/dev/null 2>&1 && [ -n "$GPG_SIGNING_KEY" ]
then
	if [ "$(git config --global user.signingkey)" != "$GPG_SIGNING_KEY" ]
	then
		git config --global user.signingkey "$GPG_SIGNING_KEY"
		git config --global commit.gpgsign true
		git config --global tag.gpgSign true
		echo "[INFO] Git GPG signing configured."
	fi
fi

# --- Init Integrations ---

# SSH Agent (Must be outside the interactive check so ~/.profile catches it for GUI logins)
if [ -f "$HOME/.ssh_agent_init" ]
then
	. "$HOME/.ssh_agent_init"
fi

# Only load remaining integrations if the shell is interactive
if [ -n "$PS1" ]
then
	# Prompt for SSH keys if the agent is empty
	if ! ssh-add -l >/dev/null 2>&1
	then
		ssh-add
	fi

	# Tmux
	if [ -z "$VSCODE_RESOLVING_ENVIRONMENT" ]
	then
		if command -v tmux >/dev/null 2>&1 && [ -z "$TMUX" ]
		then
			if tmux has-session -t main 2>/dev/null
			then
				exec tmux attach-session -t main
			else
				exec tmux new-session -s main
			fi
		fi
	fi

	# Direnv (loads .envrc files)
	if command -v direnv >/dev/null 2>&1
	then
		if [ -n "$BASH_VERSION" ]
		then
			eval "$(direnv hook bash)"
		elif [ -n "$ZSH_VERSION" ]
		then
			eval "$(direnv hook zsh)"
		fi
	fi

	# Zoxide (Smart 'cd' replacement)
	if command -v zoxide >/dev/null 2>&1
	then
		if [ -n "$BASH_VERSION" ]
		then
			eval "$(zoxide init bash)"
		elif [ -n "$ZSH_VERSION" ]
		then
			eval "$(zoxide init zsh)"
		fi
	fi

	# FZF (Keybindings)
	if [ -f "$HOME/.fzf.bash" ] && [ -n "$BASH_VERSION" ]
	then
		. "$HOME/.fzf.bash"
	elif [ -f "$HOME/.fzf.zsh" ] && [ -n "$ZSH_VERSION" ]
	then
		. "$HOME/.fzf.zsh"
	# Fallback for package manager installs
	elif [ -f /usr/share/fzf/key-bindings.bash ] && [ -n "$BASH_VERSION" ]
	then
		. "/usr/share/fzf/key-bindings.bash"
	elif [ -f /usr/share/fzf/key-bindings.zsh ] && [ -n "$ZSH_VERSION" ]
	then
		. "/usr/share/fzf/key-bindings.zsh"
	fi
fi

# --- VS Code Flatpak Shell Integration ---
# Enables VS Code terminal integration when running via Flatpak (host-spawn)
if [ "$TERM_PROGRAM" = "vscode" ]
then
	# Zero-cost check: Only run flatpak queries if the VS Code flatpak is actually installed
	if [ -d "/var/lib/flatpak/app/com.visualstudio.code" ] || [ -d "$HOME/.local/share/flatpak/app/com.visualstudio.code" ]
	then
		target_shell="zsh"
		[ -n "$BASH_VERSION" ] && target_shell="bash"
		
		# 1. Ask VS Code where the script is (returns /app/...)
		SCRIPT_IN_FP=$(flatpak run com.visualstudio.code --locate-shell-integration-path "$target_shell" 2>/dev/null)
		
		# 2. Ask Flatpak where the app is stored on the host (returns /var/lib/...)
		FP_LOCATION=$(flatpak info -l com.visualstudio.code 2>/dev/null)
		
		# 3. Replace '/app' with the real host path
		if [ -n "$FP_LOCATION" ]
		then
			REAL_PATH="${SCRIPT_IN_FP/\/app/$FP_LOCATION\/files}"
			
			if [ -f "$REAL_PATH" ]
			then
				. "$REAL_PATH"
			fi
		fi
	fi
fi
